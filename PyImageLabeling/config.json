{
    "window_size":{
        "margin": 10,
        "icon": [20, 20],
        "icon_tool": [30, 30],
        "icon_save_marker": [12, 12],
        
        "graphics_view":{
            "width":400
        },
        "labeling_bar":{
            "width": 250,
            "height": 95
        },
        "image_bar":{
            "height": 220,
            "width": 65
        },
        "label_bar":{
            "height": 75
        },
        "file_bar":{
            "width": 250
        }
    },
    "apply_cancel_bar":[
        {
            "name": "apply",
            "name_view": "Apply",
            "icon": "apply",
            "checkable": false,
            "tooltip": "Apply an operation.",
            "shortcut": "Enter"
        },
        {
            "name": "cancel",
            "name_view": "Cancel",
            "icon": "cancel",
            "checkable": false,
            "tooltip": "Cancel an operation.",
            "shortcut": "Escape"
        }
    ],
    "file_bar":[
        {
            "name": "load",
            "name_view": "Open Project…",
            "icon": "open_image",
            "checkable": false,
            "tooltip": "Open a project folder, with its images and annotations. Opening another folder closes the current project.",
            "shortcut": "Ctrl+O"
        },
        {
            "name": "save",
            "name_view": "Save",
            "icon": "save",
            "checkable": false,
            "tooltip": "Save the annotations into the project folder.",
            "shortcut": "Ctrl+S"
        },

        {
            "name": "save_copy",
            "name_view": "Save Copy…",
            "icon": "save_copy",
            "checkable": false,
            "tooltip": "Save, then copy the annotations (labels and masks, not the images) into another folder.",
            "shortcut": ""
        },

        {
            "name": "next_image",
            "name_view": "Next Image",
            "icon": "down",
            "checkable": false,
            "tooltip": "Show the next image.",
            "shortcut": "Ctrl+Right"
        },
        {
            "name": "previous_image",
            "name_view": "Previous Image",
            "icon": "up",
            "checkable": false,
            "tooltip": "Show the previous image.",
            "shortcut": "Ctrl+Left"
        }
    ],

    "image_bar":
            [
                {
                    "name": "zoom_plus",
                    "name_view": "Zoom In",
                    "icon": "zoom_plus",
                    "checkable": true,
                    "tooltip": "Zoom in.",
                    "shortcut": "Z"
                },
                {
                    "name": "zoom_minus",
                    "name_view": "Zoom Out",
                    "icon": "zoom_minus",
                    "checkable": true,
                    "tooltip": "Zoom out.",
                    "shortcut": "X"
                },
                {
                    "name": "move_image",
                    "icon": "move",
                    "checkable": true,
                    "name_view": "Move",
                    "tooltip": "Move mode: drag the image to move it around.",
                    "shortcut": "H"
                },
                {
                    "name": "reset_move_zoom_image",
                    "icon": "reset",
                    "checkable": false,
                    "name_view": "Reset View",
                    "tooltip": "Reset the position and the zoom of the image.",
                    "shortcut": "0"
                }
            ],
    "label_bar":
            {"permanent":[
                {
                    "name": "new_label",
                    "name_view": "New Label",
                    "icon": "plus",
                    "checkable": false,
                    "tooltip": "Create a new label (its masks can be imported from another folder).",
                    "shortcut": "Ctrl+N"
                },
                {
                    "name": "opacity",
                    "name_view": "Opacity",
                    "checkable": false,
                    "icon": "opacity",
                    "tooltip": "Adjust the opacity of the labels.",
                    "shortcut": "Ctrl+Shift+O"
                }
            ],
            "layer":[
                {
                    "name": "color",
                    "name_view": "Color",
                    "icon": "",
                    "checkable": false,
                    "tooltip": "Change the color of this label.",
                    "shortcut": ""
                },
                {
                    "name": "visibility",
                    "name_view": "Visibility",
                    "icon": "visibility",
                    "checkable": true,
                    "tooltip": "Show or hide this label.",
                    "shortcut": ""
                },
                {
                    "name": "label_setting",
                    "name_view": "Label Setting",
                    "icon": "setting",
                    "checkable": false,
                    "tooltip": "Settings of this label.",
                    "shortcut": ""
                },
                {
                    "name": "remove_label",
                    "name_view": "Remove Label",
                    "icon": "close",
                    "checkable": false,
                    "tooltip": "Remove this label and its masks from the project.",
                    "shortcut": "Delete"
                }
                
            ]},
    "ml_buttons_config": 
        [
            {
                "name": "ml_train",
                "name_view": "Train Model",
                "icon": "brain",
                "tooltip": "Train ML model on current annotations",
                "checkable": false,
                "slot": "ml_train_model",
                "shortcut": ""
            },
            {
                "name": "ml_predict",
                "name_view": "Predict Current",
                "icon": "magic_ball",
                "tooltip": "Generate predictions for current image",
                "checkable": false,
                "slot": "ml_predict_current",
                "shortcut": ""
            },
            {
                "name": "ml_accept",
                "name_view": "Accept Predictions",
                "icon": "check",
                "tooltip": "Convert predictions to annotations",
                "checkable": false,
                "slot": "ml_accept_predictions",
                "shortcut": ""
            },
            {
                "name": "ml_clear",
                "name_view": "Clear Predictions",
                "icon": "cleaner",
                "tooltip": "Remove all predictions from current image",
                "checkable": false,
                "slot": "ml_clear_predictions",
                "shortcut": ""
            },
            {
                "name": "sam_propagate_btn",
                "name_view": "Propagate SAM (one-shot)",
                "icon": "batch",
                "tooltip": "Use the current image + label mask as reference and propagate it to all other images (DINOv2 + SAM, no training)",
                "checkable": false,
                "slot": "sam_propagate",
                "shortcut": ""
            },
            {
                "name": "sam_text_btn",
                "name_view": "Text-to-mask",
                "icon": "border",
                "tooltip": "Describe the object in French/English (colors, shapes, position) and get a local text-to-mask preview",
                "checkable": false,
                "slot": "sam_text_mask",
                "shortcut": ""
            },
            {
                "name": "ml_review_btn",
                "name_view": "Review batch",
                "icon": "visibility",
                "tooltip": "Step through the images painted by the last propagation (review each, fix with undo/eraser)",
                "checkable": false,
                "slot": "ml_review_next",
                "shortcut": ""
            },
            {
                "name": "ml_suggest_btn",
                "name_view": "Suggest next to label",
                "icon": "open_layer",
                "tooltip": "Active learning: jump to the unlabeled image the model is most uncertain about",
                "checkable": false,
                "slot": "ml_suggest_next",
                "shortcut": ""
            }
        ],
    "labeling_bar": 
            {"pixel": {
                "name_view": "Pixel-by-pixel",
                "buttons": [
                    {
                        "name": "contour_filling",
                        "icon": "filling",
                        "icon_tool": "filling_tool",
                        "checkable": true,
                        "name_view": "Contour Filling",
                        "tooltip": "Contour filling: click inside a detected contour to fill it with the current label.",
                        "shortcut": "F"
                    },
                    {
                        "name": "paintbrush",
                        "name_view": "Paintbrush",
                        "checkable": true,
                        "icon": "paint",
                        "icon_tool": "paint_tool",
                        "tooltip": "Paintbrush: paint with the current label.",
                        "shortcut": "B"
                    },
                    {
                        "name": "magic_pen",
                        "name_view": "Magic Pen",
                        "checkable": true,
                        "icon": "magic",
                        "icon_tool": "magi_tool",
                        "tooltip": "Magic pen: click to fill the surrounding area of similar color with the current label.",
                        "shortcut": "M"
                    },
                    {
                        "name": "sam_assist",
                        "name_view": "SAM Assist",
                        "checkable": true,
                        "icon": "magic_ball",
                        "icon_tool": "magic_ball",
                        "tooltip": "SAM2 interactive: left-click=+ point, shift/right-click=- point, drag=box. Needs transformers + weights (first run downloads ~150MB).",
                        "shortcut": "A"
                    }
                ]
            }
            ,
            "geometric":{
                "name_view": "Geometric shapes",
                "buttons": [
                    {
                        "name": "ellipse",
                        "name_view": "Ellipse",
                        "checkable": true,
                        "icon": "ellipse",
                        "tooltip": "Ellipse: drag to draw an ellipse with the current label.",
                        "shortcut": "L"
                    },
                    {
                        "name": "rectangle",
                        "name_view": "Rectangle",
                        "checkable": true,
                        "icon": "rectangle",
                        "tooltip": "Rectangle: drag to draw a rectangle with the current label.",
                        "shortcut": "R"
                    },
                    {
                        "name": "polygon",
                        "name_view": "Polygon",
                        "checkable": true,
                        "icon": "polygon",
                        "tooltip": "Polygon: click to add points, click the first point again to close the shape.",
                        "shortcut": "P"
                    }
                ]}
            ,
            "edit":{
                "name_view": "Edition",
                "buttons": [
                {
                    "name": "change_label",
                    "name_view": "Change Labeled Area",
                    "checkable": true,
                    "icon": "changelabel",
                    "tooltip": "Change labeled area: click an annotated area to move it to the target label (set in its settings).",
                    "shortcut": "C"
                },
                {
                    "name": "undo",
                    "name_view": "Undo",
                    "checkable": false,
                    "icon": "back",
                    "tooltip": "Undo the last change.",
                    "shortcut": "Ctrl+Z"
                },
                {
                    "name": "eraser",
                    "name_view": "Eraser",
                    "checkable": true,
                    "icon": "eraser",
                    "icon_tool": "eraser_tool",
                    "tooltip": "Eraser: erase the current label.",
                    "shortcut": "E"
                },
                {
                    "name": "clear_all",
                    "name_view": "Clear All",
                    "checkable": false,
                    "icon": "cleaner",
                    "tooltip": "Clear the current label on this image.",
                    "shortcut": "Ctrl+Shift+C"
                }
            ]}
            }
        ,
